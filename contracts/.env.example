# Clave privada de la wallet para deploy (sin 0x)
PRIVATE_KEY=tu_clave_privada_aqui

# RPCs opcionales (tienen defaults públicos)
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC=https://sepolia.base.org

# RPC de Polygon mainnet (demo)
POLYGON_RPC=
# Agregadores de Pruebas de Inocencia, separados por coma
POI_NODE_URLS=

# Billetera pública de Bob (registra @bob desde una dirección propia)
PRIVATE_KEY_B=

# Mnemonics para wallets Railgun (demo)
# Wallet A: remitente (hace shield y envía)
MNEMONIC_A=
# Wallet B: receptor (recibe la transferencia privada)
MNEMONIC_B=
# Wallet de @incognito: alias registrado por Relay Adapt, sin historia pública
MNEMONIC_INCOGNITO=

# API Keys para verificación de contratos (opcional)
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=
